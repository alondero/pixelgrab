{
  "name": "pixelgrab",
  "version": "0.1.0",
  "description": "PixelGrab - local-first Windows desktop capture and annotation utility",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "ci:install": "pnpm install --frozen-lockfile",
    "ci:check": "pnpm format:check && pnpm lint && pnpm check && pnpm test",
    "ci:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --features synthetic -- -D warnings && cargo test --workspace --features synthetic",
    "ci:all": "pnpm ci:rust && pnpm ci:check",
    "licenses:check": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-global-shortcut": "2.3.2",
    "konva": "9.3.20"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/svelte": "5.2.4",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.5",
    "@typescript-eslint/eslint-plugin": "8.19.1",
    "@typescript-eslint/parser": "8.19.1",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "9.17.0",
    "eslint-plugin-svelte": "2.46.1",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "prettier-plugin-svelte": "3.3.2",
    "svelte": "5.55.7",
    "svelte-check": "4.1.1",
    "svelte-eslint-parser": "0.43.0",
    "tslib": "2.8.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.1",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
